# ==============================================================================
# LUNA NAVIGATOR — Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'testing')
LUNA_ENVIRONMENT=production
LUNA_DEBUG=false

# Service Metadata
LUNA_PROJECT_NAME="LUNA NAVIGATOR"
LUNA_VERSION=1.0.0

# Cross-Origin Resource Sharing (CORS) — Comma-separated list of allowed origins
LUNA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# PostgreSQL / PostGIS Database Connection
LUNA_DATABASE_URL=postgresql://luna_user:luna_password@database:5432/luna_navigator

# NASA JPL Horizons Ephemeris API Settings
LUNA_HORIZONS_API_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
LUNA_HORIZONS_TIMEOUT_SECONDS=30.0

# Geospatial Dataset Storage Paths
LUNA_DATASETS_DIR=datasets
LUNA_LOLA_DEM_PATH=datasets/dem/lola_south_pole_benchmark.npz
LUNA_CANDIDATE_SITES_PATH=datasets/sample/candidate_sites.json

# Frontend Vite Port (Default: 5173)
VITE_API_URL=/api
