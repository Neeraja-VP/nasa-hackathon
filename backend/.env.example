PROJECT_NAME="LUNA NAVIGATOR"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://localhost

HORIZONS_API_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
HORIZONS_TIMEOUT_SECONDS=30.0

DATASETS_DIR=../datasets
LOLA_DEM_PATH=../datasets/dem/lola_south_pole_100m.tif
CANDIDATE_SITES_PATH=../datasets/sample/candidate_sites.json

DATABASE_URL=postgresql://luna_user:luna_password@localhost:5432/luna_navigator
